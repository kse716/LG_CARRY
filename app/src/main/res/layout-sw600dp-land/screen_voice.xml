<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voiceScreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F9"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp"
    android:paddingEnd="40dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/voiceBackIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_chevron_left" />
        </FrameLayout>
        <TextView
            android:id="@+id/voiceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="음성 호출"
            android:textColor="#12181B"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_voice_soft_circle" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Galaxy Tab · 가로 모드" android:textColor="#00756D" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/voiceIdleGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="16dp" android:layout_weight="1" android:background="@drawable/bg_card">
                <View android:layout_width="340dp" android:layout_height="340dp" android:layout_gravity="center" android:background="@drawable/bg_voice_circle_idle_outer" />
                <View android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center" android:background="@drawable/bg_voice_circle_idle_mid" />
                <View android:layout_width="190dp" android:layout_height="190dp" android:layout_gravity="center" android:background="@drawable/bg_voice_circle_idle_inner" />
                <FrameLayout
                    android:id="@+id/voiceIdleMic"
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_voice_mic_button"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true">
                    <ImageView android:layout_width="66dp" android:layout_height="66dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_mic" />
                </FrameLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="16dp" android:layout_weight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="44dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="버튼을 눌러 말해보세요" android:textColor="#14191B" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="CARRY가 트레이와 이동 장소를 인식합니다.\n자연스럽게 한 문장으로 말씀해 주세요." android:textColor="#798385" android:textSize="17sp" android:lineSpacingExtra="6dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:background="@drawable/bg_voice_soft_circle" android:padding="22dp" android:text="예: 책상에 있는 트레이 가져와줘" android:textColor="#00756D" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="마이크를 탭하면 음성 인식이 시작됩니다" android:textColor="#798385" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voiceListeningGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="16dp" android:layout_weight="1" android:background="@drawable/bg_card">
                <View android:layout_width="360dp" android:layout_height="360dp" android:layout_gravity="center" android:background="@drawable/bg_voice_circle_idle_outer" />
                <View android:layout_width="270dp" android:layout_height="270dp" android:layout_gravity="center" android:background="@drawable/bg_voice_circle_idle_mid" />
                <View android:id="@+id/voiceMicPulseRing" android:layout_width="178dp" android:layout_height="178dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/bg_voice_mic_pulse_ring" />
                <FrameLayout
                    android:id="@+id/voiceListeningMic"
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_voice_mic_button"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:focusable="true">
                    <ImageView android:layout_width="66dp" android:layout_height="66dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_mic" />
                </FrameLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="16dp" android:layout_weight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="44dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="듣고 있어요..." android:textColor="#008E84" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="명령을 말한 뒤 잠시 기다리세요" android:textColor="#798385" android:textSize="17sp" />
                <LinearLayout
                    android:id="@+id/voiceBars"
                    android:layout_width="240dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="34dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <View android:layout_width="9dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_voice_circle_teal" />
                    <View android:layout_width="9dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_voice_circle_teal" />
                    <View android:layout_width="9dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_voice_circle_teal" />
                    <View android:layout_width="9dp" android:layout_height="56dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_voice_circle_teal" />
                    <View android:layout_width="9dp" android:layout_height="34dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_voice_circle_teal" />
                    <View android:layout_width="9dp" android:layout_height="62dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_voice_circle_teal" />
                    <View android:layout_width="9dp" android:layout_height="42dp" android:background="@drawable/bg_voice_circle_teal" />
                </LinearLayout>
                <TextView
                    android:id="@+id/voiceStopButton"
                    android:layout_width="220dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="34dp"
                    android:background="@drawable/bg_voice_outline_button_pill"
                    android:gravity="center"
                    android:text="말하기 종료"
                    android:textColor="#008E84"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voiceResultGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="16dp" android:layout_weight="1.08" android:background="@drawable/bg_card" android:gravity="center_horizontal" android:orientation="vertical" android:padding="38dp">
                <FrameLayout android:id="@+id/voiceResultCheckIcon" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_voice_circle_teal">
                    <ImageView android:id="@+id/voiceResultStatusIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_check_white" />
                </FrameLayout>
                <TextView android:id="@+id/voiceResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:maxLines="2" android:text="인식 완료" android:textColor="#14191B" android:textSize="24sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_voice_soft_circle" android:orientation="vertical" android:padding="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="인식한 명령" android:textColor="#798385" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/voiceResultCommand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="54dp" android:textColor="#14191B" android:textSize="20sp" android:textStyle="bold" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:background="#D8E5E4" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:id="@+id/voiceResultModuleIcon" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_voice_soft_circle"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_box" app:tint="#008E84" /></FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="가져올 트레이" android:textColor="#798385" android:textSize="15sp" />
                        <TextView android:id="@+id/voiceResultModule" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#008E84" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:id="@+id/voiceResultLocationIcon" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_voice_soft_circle"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_pin" /></FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="가져갈 장소" android:textColor="#798385" android:textSize="15sp" />
                        <TextView android:id="@+id/voiceResultLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#008E84" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="16dp" android:layout_weight="0.92" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="34dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="실행 전 확인" android:textColor="#14191B" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="인식 결과가 맞으면 CARRY를 실행하세요." android:textColor="#798385" android:textSize="14sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:orientation="horizontal">
                    <TextView android:id="@+id/voiceRetryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="0.72" android:background="@drawable/bg_voice_outline_button" android:gravity="center" android:text="다시 말하기" android:textColor="#008E84" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/voiceExecuteButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1.28" android:background="@drawable/bg_voice_primary_button" android:gravity="center" android:text="CARRY 실행하기" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="빠른 테스트" android:textColor="#14191B" android:textSize="16sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/voiceMissionTestButtons" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginBottom="6dp" android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:id="@+id/voiceMissionOneButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_voice_outline_button" android:gravity="center" android:text="아이방 서랍 → 안방" android:textColor="#008E84" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/voiceMissionTwoButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_voice_outline_button" android:gravity="center" android:text="안방 서랍 → 아이방" android:textColor="#008E84" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:id="@+id/voiceMissionThreeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_voice_outline_button" android:gravity="center" android:text="아이방 서랍 → 현관" android:textColor="#008E84" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/voiceMissionFourButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_voice_outline_button" android:gravity="center" android:text="안방 서랍 → 현관" android:textColor="#008E84" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:id="@+id/voiceMissionFiveButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_voice_outline_button" android:gravity="center" android:text="아이방 서랍 → 거실" android:textColor="#008E84" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/voiceMissionSixButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_voice_outline_button" android:gravity="center" android:text="안방 서랍 → 거실" android:textColor="#008E84" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/voiceEmergencyStopButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/bg_emergency_stop_button" android:gravity="center" android:text="긴급 정지" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
