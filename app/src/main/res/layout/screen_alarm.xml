<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmCanvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F9">

    <FrameLayout
        android:id="@+id/alarmBackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_left" />
    </FrameLayout>



    <TextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="알림음"
        android:textColor="#12181B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="20dp"
        android:includeFontPadding="false"
        android:text="알림음 선택"
        android:textColor="#798385"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/alarmListCard"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card">

        <FrameLayout
            android:id="@+id/alarmDefaultRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="18dp"
                android:includeFontPadding="false"
                android:text="기본 알림음"
                android:textColor="#14191B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarmDefaultCheck"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#008E84"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="56dp"
            android:background="#E2E7E7" />

        <FrameLayout
            android:id="@+id/alarmSoftRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="56dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="18dp"
                android:includeFontPadding="false"
                android:text="부드러운 알림음"
                android:textColor="#14191B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarmSoftCheck"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#008E84"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="112dp"
            android:background="#E2E7E7" />

        <FrameLayout
            android:id="@+id/alarmSilentRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="112dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="18dp"
                android:includeFontPadding="false"
                android:text="무음"
                android:textColor="#14191B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarmSilentCheck"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#008E84"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
