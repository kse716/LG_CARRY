<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="CARRY"
                android:textColor="#C30B45"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Home"
                android:textColor="#111111"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="• 86%"
            android:textColor="#74787F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_stage"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/homeTray1Button"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_tray_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tray_name1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="1번 트레이"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_tray1"
                android:layout_width="94dp"
                android:layout_height="68dp"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:contentDescription="1번 트레이"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tray" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeTray2Button"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_tray_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tray_name2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="2번 트레이"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_tray2"
                android:layout_width="94dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:contentDescription="2번 트레이"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tray" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeTray3Button"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_tray_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tray_name3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="3번 트레이"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_tray3"
                android:layout_width="94dp"
                android:layout_height="68dp"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:contentDescription="3번 트레이"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tray" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeTrayItemsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="트레이를 누르면 보관된 물품이 아래에서 열려요."
            android:textColor="#8A8D94"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
