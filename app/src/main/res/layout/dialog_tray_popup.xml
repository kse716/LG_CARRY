<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:layout_margin="20dp"

    android:background="@drawable/popup_round_bg">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/ic_tray"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/popup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="서랍 상세 정보"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2C3033"
        android:gravity="center" />

    <TextView
        android:id="@+id/popup_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="여기에 DB에서 가져온 서랍 안의 상세 내용이나 아이템 목록을 동적으로 띄워줍니다."
        android:textSize="14sp"
        android:textColor="#555A60"
        android:gravity="center" />

    <Button
        android:id="@+id/btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="닫기"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2C3033"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>