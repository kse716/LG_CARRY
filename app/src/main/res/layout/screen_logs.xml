<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/logsCanvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F9">

    <FrameLayout
        android:id="@+id/logsBackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true" >

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_chevron_left"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="로그 기록"
        android:textColor="#12181B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/logsChipToday"
        android:layout_width="52dp"
        android:layout_height="30dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="67dp"
        android:background="@drawable/bg_chip_soft"
        android:gravity="center"
        android:text="오늘"
        android:textColor="#009688"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/logsChipWeek"
        android:layout_width="67dp"
        android:layout_height="30dp"
        android:layout_marginLeft="76dp"
        android:layout_marginTop="67dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:text="이번 주"
        android:textColor="#7C878A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/logsChipMonth"
        android:layout_width="67dp"
        android:layout_height="30dp"
        android:layout_marginLeft="151dp"
        android:layout_marginTop="67dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:text="이번 달"
        android:textColor="#7C878A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/logsChipAll"
        android:layout_width="52dp"
        android:layout_height="30dp"
        android:layout_marginLeft="226dp"
        android:layout_marginTop="67dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:text="전체"
        android:textColor="#7C878A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/logsFilterTitle"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="121dp"
        android:gravity="left"
        android:text="2000.00.00 (월)"
        android:textColor="#7C878A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/logsFilterLabel"
        android:visibility="gone"
        android:layout_width="62dp"
        android:layout_height="17dp"
        android:layout_marginLeft="288dp"
        android:layout_marginTop="119dp"
        android:background="@drawable/bg_chip_soft"
        android:gravity="center"
        android:text="오늘"
        android:textColor="#009688"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/logsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="145dp"
        android:layout_marginBottom="24dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/logsLoadingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="濡쒓렇瑜?遺덈윭?ㅻ뒗 以묒엯?덈떎."
                android:textColor="#7C878A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/logsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/logsEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:gravity="center"
                android:text="濡쒓렇媛 ?놁뒿?덈떎."
                android:textColor="#798385"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
