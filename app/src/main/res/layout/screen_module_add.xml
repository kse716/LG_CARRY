<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moduleAddCanvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F9">

    <FrameLayout
        android:id="@+id/moduleAddBackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true" >

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_chevron_left"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="트레이 추가"
        android:textColor="#12181B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="78dp"
        android:includeFontPadding="false"
        android:text="트레이 이름"
        android:textColor="#798385"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/moduleAddNameInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="108dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:hint="트레이 이름 입력"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#14191B"
        android:textColorHint="#9AA3A5"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="176dp"
        android:includeFontPadding="false"
        android:text="초기 보관 위치"
        android:textColor="#798385"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/moduleAddLocationSelector"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="206dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:text="거실"
            android:textColor="#008E84"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="현관"
            android:textColor="#798385"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="침실"
            android:textColor="#798385"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/moduleAddLocationDropdown"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="260dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card" />

    <TextView
        android:id="@+id/moduleAddHelpText"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="270dp"
        android:includeFontPadding="false"
        android:text="트레이의 위치를 변경하면 루틴 설정에 반영됩니다."
        android:textColor="#798385"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moduleAddSaveButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="312dp"
        android:background="@drawable/bg_voice_primary_button"
        android:gravity="center"
        android:text="트레이 등록하기"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</FrameLayout>
