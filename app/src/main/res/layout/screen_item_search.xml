<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemSearchCanvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F9">

    <FrameLayout
        android:id="@+id/itemSearchBackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_chevron_left"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="물품 검색"
        android:textColor="#12181B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/itemSearchInput"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:hint="물품명 입력"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#14191B"
        android:textColorHint="#9AA3A5"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/itemSearchResultCount"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="142dp"
        android:layout_marginEnd="20dp"
        android:includeFontPadding="false"
        android:textColor="#798385"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/itemSearchEmptyText"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="172dp"
        android:layout_marginEnd="20dp"
        android:includeFontPadding="false"
        android:text="검색어와 일치하는 물품이 없습니다."
        android:textColor="#798385"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/itemSearchResultsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="172dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical" />
</FrameLayout>
