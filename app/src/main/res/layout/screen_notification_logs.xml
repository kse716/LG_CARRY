<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificationLogsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F9"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/notificationLogsCanvas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F9F9"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <FrameLayout
                android:id="@+id/notificationLogsBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_left" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="52dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="로그 기록"
                android:textColor="#12181B"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/notificationLogsFilterGroup"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notificationLogsFilterToday"
                style="@style/LogFilterChipStyle"
                android:text="오늘" />

            <TextView
                android:id="@+id/notificationLogsFilterWeek"
                style="@style/LogFilterChipStyle"
                android:layout_marginStart="8dp"
                android:text="이번 주" />

            <TextView
                android:id="@+id/notificationLogsFilterMonth"
                style="@style/LogFilterChipStyle"
                android:layout_marginStart="8dp"
                android:text="이번 달" />

            <TextView
                android:id="@+id/notificationLogsFilterAll"
                style="@style/LogFilterChipStyle"
                android:layout_marginStart="8dp"
                android:text="전체" />
        </LinearLayout>

        <TextView
            android:id="@+id/notificationLogsDateLabel"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="#798385"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/notificationLogsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/notificationLogsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="알림 기록이 없습니다."
            android:textColor="#7C878A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
