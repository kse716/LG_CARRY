<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signupCanvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F9">

        <FrameLayout
            android:id="@+id/signupBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="52dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="회원가입"
            android:textColor="#12181B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="88dp"
            android:layout_marginEnd="20dp"
            android:includeFontPadding="false"
            android:text="아이디"
            android:textColor="#12181B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signupIdInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="112dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_input"
            android:hint="사용자 아이디 입력"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#12181B"
            android:textColorHint="#9AA3A5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="176dp"
            android:layout_marginEnd="20dp"
            android:includeFontPadding="false"
            android:text="비밀번호"
            android:textColor="#12181B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signupPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="200dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_input"
            android:hint="비밀번호 입력"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#12181B"
            android:textColorHint="#9AA3A5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="264dp"
            android:layout_marginEnd="20dp"
            android:includeFontPadding="false"
            android:text="이름"
            android:textColor="#12181B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signupNameInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="288dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_input"
            android:hint="이름 입력"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#12181B"
            android:textColorHint="#9AA3A5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/signupSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="372dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_voice_primary_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="회원가입"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
</FrameLayout>
